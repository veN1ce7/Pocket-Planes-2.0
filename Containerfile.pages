FROM docker.io/library/node:20-bookworm-slim AS build

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

# Generuj względne ścieżki:
# ./static/js/... zamiast /static/js/...
ENV PUBLIC_URL=.

RUN npm run build


FROM docker.io/library/busybox:1.36

WORKDIR /site

COPY --from=build /app/build/ ./

# GitHub Pages ma publikować pliki statyczne bez Jekylla.
RUN touch .nojekyll

CMD ["sh", "-c", "find /site -maxdepth 3 -type f | sort"]
