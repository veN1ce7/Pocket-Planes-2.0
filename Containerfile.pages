FROM docker.io/library/node:20-bookworm-slim AS build

WORKDIR /app

# package-lock.json w tym repozytorium jest pusty,
# więc instalujemy zależności wyłącznie na podstawie package.json.
COPY package.json ./
RUN npm install

COPY . .

RUN npm run build


FROM docker.io/library/busybox:1.36

WORKDIR /site

COPY --from=build /app/build/ ./

# GitHub Pages ma serwować gotowe pliki bez przetwarzania przez Jekyll.
RUN touch .nojekyll

CMD ["sh", "-c", "find /site -maxdepth 3 -type f | sort"]
